# --- UI target (SauceDemo - public demo shop) ---
SAUCE_BASE_URL=https://www.saucedemo.com
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# --- API target (Restful-Booker - public demo API) ---
BOOKING_API_BASE_URL=https://restful-booker.herokuapp.com
BOOKING_API_USERNAME=admin
BOOKING_API_PASSWORD=password123

# --- Jira (used by the RAG defect-triage agent, not by the tests themselves) ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=QA

# --- LLM used by the RAG agent ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set to "true" to only print the drafted Jira issue instead of creating it
RAG_DRY_RUN=true
